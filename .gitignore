.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Editable-install metadata, rewritten by every `uv run`. `uv.lock` beside it is
# committed: this is an application, not a library, and every other input to a
# build here is pinned.
*.egg-info/

# Run directories: state, inventory, seed ISOs, tofu JSON streams.
runs/

# OpenTofu working state. The lock file is committed deliberately
# (docs/provider-0.9.8.lock.hcl); this is the initialised tree.
.terraform/
*.tfstate
*.tfstate.backup

# Dev-box provider mirror. Rebuildable from docs/provider-0.9.8.lock.hcl;
# the real one is baked into the image at /opt/tofu-mirror.
.tools/
