# The build context. Nothing under `.tools/` reaches the image; it is a
# rebuildable dev convenience.
.git/
.venv/
.pytest_cache/
__pycache__/
*.pyc
runs/
.cache/
.tools/

# Not the deliverable: no instruction in the Containerfile reaches into any of
# these, so docs, tests, CI config and agent config are pure context cost.
#
# **The patterns above are not recursive.** They are matched against the whole
# relative path with `filepath.Match` semantics, so `.venv/` matches `./.venv`
# and nothing deeper -- measured: a nested `.venv` and `.tools` both reach the
# builder while the top-level ones do not. That is why `.claude/` is excluded
# whole rather than `.claude/worktrees/`: a worktree checked out inside the tree
# carries its own venv and tool binaries, and measured 113 MiB against 4.7 MiB
# for one with neither.
docs/
tests/
.github/
.claude/
